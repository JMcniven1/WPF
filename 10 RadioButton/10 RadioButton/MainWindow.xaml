<Window x:Class="_10_RadioButton.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_10_RadioButton"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock HorizontalAlignment="Left" Margin="67,61,0,0" TextWrapping="Wrap" Text="a:" VerticalAlignment="Top"/>
        <TextBox x:Name="txtA" HorizontalAlignment="Left" Margin="81,60,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="66,82,0,0" TextWrapping="Wrap" Text="b:" VerticalAlignment="Top"/>
        <TextBox x:Name="txtB" HorizontalAlignment="Left" Margin="81,82,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        <RadioButton x:Name="rbnSuma" Content="Suma" HorizontalAlignment="Left" Margin="66,126,0,0" VerticalAlignment="Top" GroupName="Operaciones" IsChecked="True"/>
        <RadioButton x:Name="rbnResta" Content="Resta" HorizontalAlignment="Left" Margin="66,146,0,0" VerticalAlignment="Top" GroupName="Operaciones"/>
        <RadioButton x:Name="rbnMulti" Content="Multi" HorizontalAlignment="Left" Margin="66,166,0,0" VerticalAlignment="Top" GroupName="Operaciones"/>
        <RadioButton x:Name="rbnDiv" Content="Div" HorizontalAlignment="Left" Margin="66,186,0,0" VerticalAlignment="Top" GroupName="Operaciones"/>
        <RadioButton x:Name="rbnCmAPul" Content="Cm a pulgadas" HorizontalAlignment="Left" Margin="315,129,0,0" VerticalAlignment="Top" GroupName="Convertir" IsChecked="True"/>
        <RadioButton x:Name="rbnPulACm" Content="Pulgadas a Cm" HorizontalAlignment="Left" Margin="315,146,0,0" VerticalAlignment="Top" GroupName="Convertir"/>

    </Grid>
</Window>
