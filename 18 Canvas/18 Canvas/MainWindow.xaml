<Window x:Class="_18_Canvas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_18_Canvas"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Canvas>
        <Button Canvas.Left="10" Canvas.Top="20">Boton 1</Button>
        <Button Canvas.Right="10" Canvas.Top="30">Boton 2</Button>
        <Button Canvas.Bottom="20" Canvas.Left="10">Boton 3</Button>
        <Button Canvas.Bottom="30" Canvas.Right="20">Boton 4</Button>
    </Canvas>
</Window>
