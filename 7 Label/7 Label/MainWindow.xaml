<Window x:Class="_7_Label.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_7_Label"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Margin="20,20,550,20">
        <Label>Hola a todos</Label>
        
        <Label Content="_Nombre" Target="{Binding ElementName=txtNombre}"/>
        <TextBox x:Name="txtNombre"/>

        <Label Content="_Apellido" Target="{Binding ElementName=txtApellido}"/>
        <TextBox x:Name="txtApellido"/>

        <Label Content="_Mensaje" Target="{Binding ElementName=btnMensaje}" Name="lblMensaje"/>
        <Button x:Name="btnMensaje" Content="Mensaje" Click="btnMensaje_Click"/>

        <Label>
            <StackPanel Orientation="Horizontal">
                <TextBlock>Hola</TextBlock>
                <TextBlock>a mis amigos</TextBlock>
            </StackPanel>
        </Label>


    </StackPanel>
</Window>
