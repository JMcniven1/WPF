<Window x:Class="_13_ToolTip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_13_ToolTip"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Foreground="#FF00A018">
    <Grid>
        <TextBox HorizontalAlignment="Left" ToolTip="Coloca tu mensaje" Margin="71,60,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" BorderBrush="#FF26439C" SelectionBrush="#FF2C83C8" SelectionTextBrush="#FFA02323"/>
        <Button Content="Button" HorizontalAlignment="Left" Margin="151,102,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.357,0.569"
                ToolTipService.ShowDuration="500" ToolTipService.HorizontalOffset="300" ToolTipService.VerticalOffset="30">
            <Button.ToolTip>
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="Blue">
                        Al oprimir el boton se mostrara un mensaje <LineBreak/>
                        Debe de usarse cuando el textbox ya tenga algun contenido
                    </TextBlock>
                </StackPanel>
            </Button.ToolTip>
        </Button>



    </Grid>
</Window>
