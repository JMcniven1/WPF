<Window x:Class="_23_GridPanel_II.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_23_GridPanel_II"
        mc:Ignorable="d"
        Title="MainWindow" Height="300" Width="480">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Grid.Column="0" Grid.Row="0">Boton 1</Button>
        <Button Grid.Column="2" Grid.Row="0">Boton 2</Button>
        <Button Grid.Column="1" Grid.Row="1">Boton 3</Button>

        <Button Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2">Boton 4</Button>
        <Button Grid.Column="2" Grid.Row="2" Grid.RowSpan="2">Boton 5</Button>
        <Button Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Grid.RowSpan="2">Boton 6</Button>

    </Grid>
</Window>
