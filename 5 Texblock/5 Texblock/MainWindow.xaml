<Window x:Class="_5_Texblock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_5_Texblock"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock Margin="20,30,65,100">Este es un texto muy largo que  me sirve de ejemplo, verlo con + y -</TextBlock>
        <TextBlock Margin="20,50,0,0">Aqui pongo mi primera linea <LineBreak/>
        Y esta es la segunda lineq aue coloco</TextBlock>
        <TextBlock Margin="20,90,0,0" TextTrimming="CharacterEllipsis">Este es otro texto muy largo que auisq no se muestre</TextBlock>
        <TextBlock Margin="20,110,0,0 " TextWrapping="Wrap">Este es otro texto muy largo que se va a adaptar a la ventana</TextBlock>
        <TextBlock Margin="20,130,0,0" Foreground="Aquamarine" FontSize="20" FontFamily="Impact">Hola a todos</TextBlock>
    </Grid>
</Window>
