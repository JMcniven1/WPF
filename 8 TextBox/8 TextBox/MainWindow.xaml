<Window x:Class="_8_TextBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_8_TextBox"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!--
        
        -->
        <TextBox Name="txtNombres" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="94,68,0,0" TextWrapping="Wrap" Text="Pon tu nombre"  Width="120"/>
        <Button Name="btnMensaje" Content="Mensaje" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="234,68,0,0" Click="btnMensaje_Click"/>
        <TextBlock x:Name="txbEscribe" HorizontalAlignment="Left" Margin="94,24,0,0" Text="///" TextWrapping="Wrap" VerticalAlignment="Top"/>

        <TextBox Name="txtMultilineas" HorizontalAlignment="Left" Margin="94,124,0,0" 
                 AcceptsReturn="True" TextWrapping="Wrap" Text="Escribe" VerticalAlignment="Top" Width="120" Height="120"/>
        <Button Name="btnLimpiar" Content="Limpiar" HorizontalAlignment="Left" Margin="234,141,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.492,1.474" Click="btnLimpiar_Click" />
        <Button Name="btnSeleccion" Content="Seleccionar" HorizontalAlignment="Left" Margin="234,197,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.105,0.749" Click="btnSeleccion_Click"/>
        

    </Grid>
</Window>
