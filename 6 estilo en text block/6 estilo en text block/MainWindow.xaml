<Window x:Class="_6_estilo_en_text_block.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_6_estilo_en_text_block"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock Margin="20" TextWrapping="Wrap" FontSize="24">
            Este es un texto normal, <Bold>
     <Bold.Foreground>
         <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
             <GradientStop Color="White" Offset="1"/>
             <GradientStop Color="#FFB5A730" Offset="0.317"/>
             <GradientStop Color="#FF00029A" Offset="0.651"/>
         </LinearGradientBrush>
     </Bold.Foreground>Muy Normal</Bold>
            con mucho <Underline>estilo</Underline>. <LineBreak/>
            les recomiendo este tutorial
            <Span FontWeight="DemiBold" FontSize="38" Foreground="Blue">Mi texto con span
            <Italic>se ve</Italic> mejor</Span>
            <Run FontFamily="Consolas" FontSize="32" FontStyle="Oblique">
                <Run.Foreground>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black" Offset="0.274"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Run.Foreground>
                Aprendo XAML
            </Run>
        </TextBlock>
    </Grid>
</Window>
