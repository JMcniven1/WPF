<Window x:Class="_21_DockPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_21_DockPanel"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <Button DockPanel.Dock="Left">Boton 1</Button>
        <Button DockPanel.Dock="Top">Boton 2</Button>
        <Button DockPanel.Dock="Right">Boton 3</Button>
        <Button DockPanel.Dock="Bottom">Boton 4</Button>
        <Button DockPanel.Dock="Left" Height="40">Boton 5</Button>
        <Button DockPanel.Dock="Bottom">Boton 6</Button>
    </DockPanel>
</Window>
