<Window x:Class="_32_RichTextBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_32_RichTextBox"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <RichTextBox Margin="10">
            <FlowDocument>
                <Paragraph FontSize="42" TextAlignment="Center" FontWeight="Bold" Foreground="BlueViolet">
                    MCNIVEN
                </Paragraph>
                <Paragraph TextAlignment="Left" FontSize="18" Foreground="Blue">
                    En este canal se ofrecen cursos de programacion que puedes ver directo
                    en Youtube. Aprende a programar desde las bases a la programacion avanzada.
                </Paragraph>
            </FlowDocument>
        </RichTextBox>
    </Grid>
</Window>
