<Window x:Class="_34_Border.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_34_Border"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="500">
    <Grid Margin="10">
        <Border Background="Coral" BorderBrush="DarkBlue" BorderThickness="6">
            <StackPanel Margin="10">
                <Button Margin="5">Procesa</Button>
                <Button Margin="5">Trabaja</Button>
                <Button Margin="5">Ejecuta</Button>
                <Button Margin="5">Salir</Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
