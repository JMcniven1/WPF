<Window x:Class="_15_Acces_Key.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_15_Acces_Key"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="btnA" Content="_Abrir" HorizontalAlignment="Left" Margin="177,105,0,0" VerticalAlignment="Top" Click="btnA_Click"/>
        <Button x:Name="btnB" Content="_Borrar" HorizontalAlignment="Left" Margin="307,105,0,0" VerticalAlignment="Top" Click="btnB_Click"/>
        <Button x:Name="btnC" Content="_Cerrar" HorizontalAlignment="Left" Margin="444,105,0,0" VerticalAlignment="Top" Click="btnC_Click"/>
        <Label x:Name="lblMensaje" Content="_Mensaje" HorizontalAlignment="Left" Margin="177,169,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.073,0.098" Target="{Binding ElementName=txtMensaje}"/>
        <TextBox x:Name="txtMensaje" HorizontalAlignment="Left" Margin="267,177,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>

    </Grid>
</Window>
