<Window x:Class="_2_Boton.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2_Boton"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid HorizontalAlignment="Right" Width="800">
        <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,100,0,0">
            Mi boton
        </Button>
        <Button x:Name="btnEjemplo" Content="Button" HorizontalAlignment="Left" Margin="320,100,0,0" VerticalAlignment="Top" RenderTransformOrigin="4.23,-3.826"/>
        <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,200,0,0">
            <WrapPanel>
                <TextBlock>Mi primer contenido</TextBlock>
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,30,0,0">Mi segundo contenido</TextBlock>
            </WrapPanel>
        </Button>
    </Grid>
</Window>
