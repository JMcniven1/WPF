<Window x:Class="_33_Editor_RichText.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_33_Editor_RichText"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <ToggleButton  x:Name="btnNegritas" Command="EditingCommands.ToggleBold" >
                Negritas
            </ToggleButton>
            <Separator/>
            <ToggleButton  x:Name="btnItalicas" Command="EditingCommands.ToggleItalic" >
                Italica
            </ToggleButton>
            <Separator/>
            <ToggleButton  x:Name="btnSubrayado" Command="EditingCommands.ToggleUnderline" >
                Subrayado
            </ToggleButton>
            <Separator/>
            <ComboBox x:Name="cmbTamano" Width="60" IsEditable="True" TextBoxBase.TextChanged="cmbTamano_TextChanged" />
            <Separator/>
            <ComboBox x:Name="cmbTipografia" Width="120" IsEditable="True" SelectionChanged="cmbTipografia_SelectionChanged" />
        </ToolBar>
        <RichTextBox x:Name="rtbTexto" SelectionChanged="rbtTexto_SelectionChanged" />
    </DockPanel>
</Window>
