<Window x:Class="imagen_border_responsive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:imagen_border_responsive"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Border izquierdo vacío -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="2" Margin="10" />

        <!-- Border derecho con imagen ajustable -->
        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="2" Margin="10">
            <Grid>
                <Image Source="/Pikachu.jpg"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />
            </Grid>
        </Border>
    </Grid>
</Window>
