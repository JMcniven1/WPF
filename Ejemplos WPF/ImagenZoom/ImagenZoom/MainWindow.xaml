<Window x:Class="ImagenZoom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImagenZoom"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="2" Margin="10">
            <!-- Contenido opcional -->
        </Border>

        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="2" Margin="10" ClipToBounds="True">
            <ScrollViewer Name="scrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="True">
                <Grid>
                    <Image Name="imgZoom"
                           RenderTransformOrigin="0.5,0.5"
                           MouseWheel="imgZoom_MouseWheel"
                           Stretch="None"
                           Source="/Pikachu.jpg">
                        <Image.LayoutTransform>
                            <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
                        </Image.LayoutTransform>
                    </Image>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
