<Window x:Class="_34_Border_Ejemplo_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_34_Border_Ejemplo_2"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="300">
    <Grid>
        <Border CornerRadius="28,8,30,15" BorderBrush="DarkBlue" BorderThickness="1,2,3,4">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#FFE4E0FF" Offset="0.0" />
                    <GradientStop Color="#FFE4E53F" Offset="0.5" />
                    <GradientStop Color="#FFE400FF" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="10">
                <Button Margin="5">Procesa</Button>
                <Button Margin="5">Trabaja</Button>
                <Button Margin="5">Ejecuta</Button>
                <Button Margin="5">Salir</Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
